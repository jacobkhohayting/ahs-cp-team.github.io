# Copy this file to .env and edit it. Lines starting with # are comments.

# REQUIRED. The secret password for the admin area (http://your-site/admin).
ADMIN_PASSWORD=change-me-to-something-long

# Name shown in the top bar and browser tab.
SITE_NAME=MiniForces

# Port and bind address.
PORT=3000
HOST=0.0.0.0

# How many submissions are judged at the same time. 1 is fine for a club.
# Each extra worker needs a free user id (JUDGE_UID_BASE + n) when running as root.
JUDGE_WORKERS=1
JUDGE_UID_BASE=65000

# Multiply every problem's time limit for slower languages (1 = same limit for everyone).
JUDGE_TIME_FACTOR_PYTHON=1
JUDGE_TIME_FACTOR_JAVA=1

# Seconds a student must wait between two submissions (stops accidental double clicks).
SUBMIT_COOLDOWN_MS=3000

# Set to 1 when the site is served over HTTPS (through a reverse proxy such as Caddy or nginx).
COOKIE_SECURE=0
TRUST_PROXY=0

# Where the database lives (created automatically). Back this folder up.
DATA_DIR=data

# Compiler/interpreter commands, in case they are not on PATH under these names.
# CXX=g++
# PYTHON=python3
# JAVAC=javac
# JAVA=java
